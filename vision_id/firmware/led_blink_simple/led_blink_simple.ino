uint32_t code;
uint8_t chipIdx = 0;
unsigned long chipUs;
unsigned long nextChipAt;

void setup() {
  for (uint8_t i = 0; i < N_LEDS; i++) pinMode(LED_PINS[i], OUTPUT);
  code = pgm_read_dword(&CODES[DRONE_ID < N_IDS ? DRONE_ID : 0]);
  chipUs = (unsigned long)(1000000.0 / CHIP_HZ);

  Serial.begin(115200);
  Serial.print(F("ID="));
  Serial.print(DRONE_ID);
  Serial.print(F(" HZ="));
  Serial.print(CHIP_HZ);
  Serial.print(F(" chips="));
  for (uint8_t i = 0; i < CHIPS; i++) Serial.print((code >> (CHIPS - 1 - i)) & 1 ? '1' : '0');
  Serial.println();

  nextChipAt = micros();
}

void loop() {
  // fixed schedule (nextChipAt += chipUs) instead of delay(): no drift from loop overhead
  if ((long)(micros() - nextChipAt) >= 0) {
    nextChipAt += chipUs;
    bool on = (code >> (CHIPS - 1 - chipIdx)) & 1;
    for (uint8_t i = 0; i < N_LEDS; i++) digitalWrite(LED_PINS[i], on ? HIGH : LOW);
    chipIdx = (chipIdx + 1) % CHIPS;
  }
}
