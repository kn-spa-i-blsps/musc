/*
 * Simple LED ID beacon - blinks the drone ID code that vision_id/detector.py decodes.
 * Single file, no libraries, no Serial setup: open in Arduino IDE, set DRONE_ID / CHIP_HZ, upload.
 *
 * Wiring: pin 2 -> 220 ohm resistor -> LED anode (+, long leg); LED cathode (-, short leg) -> GND.
 * More LEDs: add pins to LED_PINS (all blink together, every visible LED carries the full ID).
 * The on-board LED (pin 13) mirrors the code too, handy to check it is running.
 *
 * Code: 26 chips per cycle, repeated forever, MSB (bit 25) sent first, 1 = LED on.
 * The receiver finds the phase itself - no sync needed.
 *
 * CHIP_HZ must match the receiver (--chip-hz) and needs ~3 camera frames per chip:
 *   laptop webcam 30 fps -> 10   (one cycle = 2.6 s)
 *   60 fps camera        -> 20   (one cycle = 1.3 s)
 *
 * Table generated from vision_id/codebook.py (same codes as firmware/led_beacon/codes.h).
 */

const uint8_t DRONE_ID = 5;          // 0..127
const float CHIP_HZ = 10.0;          // 10 for 30 fps camera, 20 for 60 fps

const uint8_t LED_PINS[] = {2, LED_BUILTIN};
const uint8_t N_LEDS = sizeof(LED_PINS);

const uint8_t CHIPS = 26;
const uint8_t N_IDS = 128;

